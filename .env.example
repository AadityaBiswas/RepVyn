# Build-time config for the web app (app/build.mjs). Copy to .env, or set these in Cloudflare Pages.
# All of these are public by design. Never put secret keys here: those go in Supabase function secrets.
REPVYN_SUPABASE_URL=https://<project-ref>.supabase.co
REPVYN_SUPABASE_ANON_KEY=<anon public key>
# Setting this turns on Pro checkout and Free/Pro gating. Use rzp_test_... until launch.
REPVYN_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
REPVYN_VAPID_PUBLIC_KEY=<from npx web-push generate-vapid-keys>
REPVYN_POSTHOG_KEY=phc_xxxxxxxx
REPVYN_POSTHOG_HOST=https://us.i.posthog.com
REPVYN_SUPPORT_EMAIL=support@repvyn.app
